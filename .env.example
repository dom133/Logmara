# PostgreSQL
POSTGRES_DB=syslog_db
POSTGRES_USER=syslog
# REQUIRED: set to a strong password (min 16 chars). Generate with: openssl rand -base64 24
POSTGRES_PASSWORD=

# RabbitMQ (tailer ingestion pipeline)
# REQUIRED: set to a strong password. Generate with: openssl rand -base64 24
RABBITMQ_PASS=

# Security keys (REQUIRED). All three are read only from the environment and
# are never stored in the database, so a database dump alone can neither forge
# session tokens nor decrypt stored SMTP/LDAP passwords. Generate each one
# separately and keep them secret and stable (rotating them invalidates all
# sessions / makes previously-encrypted settings unreadable):
#   JWT_SECRET=$(openssl rand -base64 48)
#   ENCRYPTION_KEY=$(openssl rand -base64 48)
#   TOKEN_HASH_KEY=$(openssl rand -hex 32)
# TOKEN_HASH_KEY is the HMAC key used to hash refresh tokens and API keys
# before they're stored, so even a full database dump yields only keyed
# digests, not usable tokens.
# Alternatively point JWT_SECRET_FILE / ENCRYPTION_KEY_FILE / TOKEN_HASH_KEY_FILE
# at a mounted secret file instead of setting the values here. The app refuses
# to start (or to finish first-time setup) until all three are present.
# Minimum 32 characters.
JWT_SECRET=
ENCRYPTION_KEY=
TOKEN_HASH_KEY=

# MAINTENANCE_TOKEN (optional but recommended): shared secret that gates the
# unauthenticated /api/maintenance/pre-update endpoint (pauses ingestion and
# compacts logs) on top of Docker-network isolation. The deploy script sends
# it as the X-Maintenance-Token header. If left empty the endpoint relies on
# network isolation only. Generate with `openssl rand -hex 32`.
#MAINTENANCE_TOKEN=

# JWT_PRIVATE_KEY (optional, dual-mode): an RSA private key (PKCS#8 PEM, >=
# 2048 bits) used to sign session tokens with RS256 instead of the symmetric
# HS256 (JWT_SECRET). When set, NEW tokens are RS256 while existing HS256
# tokens keep validating against JWT_SECRET until they expire - so enabling it
# does not log anyone out. Only the holder of this private key can mint tokens
# (the public key, needed to validate, is derived from it). Generate one with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt_private.pem
# then point JWT_PRIVATE_KEY_FILE at that file (preferred) or paste the PEM into
# JWT_PRIVATE_KEY. Leave empty to keep HS256-only (the default).
#JWT_PRIVATE_KEY_FILE=
#JWT_PRIVATE_KEY=

# Pre-built image tag pulled by docker-compose.yml (dom133/logmara-* on
# Docker Hub). Bump this to move to a newer release without editing the
# compose file. Not used by docker-compose.build.yml, which always builds
# from local source instead.
#IMAGE_TAG=v0.1.0

# Ports
FRONTEND_PORT=80
RSYSLOG_PORT=514
#FRONTEND_HTTPS_PORT=443
# Direct TLS syslog ingestion (no client certificate required, see README
# "Syslog Relay" / rsyslog/syslog.conf) - same ingestion as RSYSLOG_PORT
# above, just wrapped in TLS.
#SYSLOG_TLS_PORT=6514
# mTLS listener for remote syslog relays.
#RELAY_MTLS_PORT=6515

# HTTPS (optional, both disabled by default). Only seeds the Settings stored
# in the database the first time the app starts (or if never overridden from
# the admin UI); afterwards it's managed from Admin > Settings and this env
# var is ignored on subsequent restarts.
#HTTPS_ENABLED=false
#HTTPS_REDIRECT=false

# CORS (optional). Comma-separated list of origins allowed to call the API
# from a browser, e.g. http://localhost:3000,https://yourdomain.com. Only
# used to seed the initial value in the database the first time the app is
# initialized; afterwards it's managed from the admin Settings UI.
#CORS_ORIGINS=

# Syslog Relay (optional, see README "Syslog Relay"). Everything for this
# feature (enable/disable, whitelist, certificates) is managed from
# Admin > Settings / Admin > Syslog Relay.
#
# This server's hostname/IP as reachable from a relay's VLAN, pre-filled
# into the relay.conf bundled with every certificate you generate. Only a
# fallback - the Central Server Address field on the Syslog Relay page
# takes priority over this if set; if neither is set, relay.conf defaults
# to 127.0.0.1 (only useful for same-host testing).
#RELAY_CENTRAL_HOST=

# Cloud Bridge (optional, see README "Cloud Bridge (Optional)"). Off by
# default. Set to "true" to enable the Admin > Cloud Bridge tab; pairing
# itself is then a separate, explicit admin action from that tab.
#CLOUD_BRIDGE_ENABLED=
# Only needed if the frontend container isn't reachable at the default
# "http://frontend" (see backend/cloudbridge/cloudbridge.go).
#CLOUD_BRIDGE_FRONTEND_UPSTREAM=
# Certificate handling is locked by default: pairing saves and connects the
# certificates Logmara Cloud issues automatically - they never appear in the
# UI, and there's no replace/repair path short of disconnecting and pairing
# again. Set to "false" to instead show the raw mTLS certificate material in
# the admin UI for manual review/re-saving.
#CLOUD_BRIDGE_LOCK_CERTIFICATES=

# ---------------------------------------------------------------------------
# High Availability deployment only (docker-stack.postgres.yml /
# docker-stack.redis.yml / docker-stack.app.yml). Not used by the default
# docker-compose.yml single-server setup above — see README "High
# Availability Deployment".
# ---------------------------------------------------------------------------

# Container image registry both stacks pull from. Every Swarm node must be
# able to `docker pull` from it. Required (no default) when deploying either
# docker-stack.*.yml.
#REGISTRY=registry.example.com/logmara
#TAG=latest

# NFS export backing the shared log_data/log_spool/parser_defs volumes used
# by the floating api/rsyslog/frontend services in docker-stack.app.yml.
#NFS_SERVER=10.0.0.10
#NFS_LOG_DATA_PATH=/srv/syslog-ha/nfs/log_data
#NFS_LOG_SPOOL_PATH=/srv/syslog-ha/nfs/log_spool
#NFS_PARSER_DEFS_PATH=/srv/syslog-ha/nfs/parser_defs

# POSTGRES_PASSWORD here is the app role's password used in the API's
# DATABASE_URL (see docker-stack.app.yml) — it must equal the content of the
# `pg_app_password` Swarm secret created via scripts/swarm-bootstrap.sh
# secrets, which is what actually sets the role's password in Postgres.
#POSTGRES_PASSWORD=change-this-and-match-the-pg_app_password-secret

# Redis Sentinel password (backend/sharedstate), required for api/frontend
# to run more than 1 replica each — see README "How multi-replica safety
# works". Leave it unset to keep the original single-process, in-memory
# behavior (also what docker-compose.yml uses). The sentinel addresses and
# master name themselves are fixed in docker-stack.app.yml to match
# docker-stack.redis.yml's service names, so they aren't configurable here.
# When VAULT_ADDR is deployed (docker-stack.app.yml), api reads this from
# Vault's HTTP API instead (backend/util.SecretFromEnv) and this env var is
# unused; it only matters for a plain docker-compose.yml deployment, where
# it must equal the value redis-server itself was started with.
#REDIS_PASSWORD=change-this-and-match-the-redis_password-secret

# RabbitMQ password (tailer ingestion pipeline). Same Vault-first rule as
# REDIS_PASSWORD above: only used when Vault isn't configured. It must equal
# the value RabbitMQ itself was started with.
#RABBITMQ_PASS=change-this-and-match-the-rabbitmq_password-secret

# How many api/frontend replicas docker-stack.app.yml runs. Only safe above
# 1 with Redis Sentinel configured (see above).
#API_REPLICAS=2
#FRONTEND_REPLICAS=2

# FRONTEND_PORT/FRONTEND_HTTPS_PORT above are reused as-is for haproxy-app's
# :80/:443 (it replaces frontend as the thing actually bound to those ports
# in the HA stack). haproxy-app never publishes the API directly - all
# traffic goes through nginx on :80/:443, which in turn is load-balanced
# across every api replica via haproxy-app's internal :8090 listener.

# Host port haproxy-app's stats page (haproxy/haproxy-app.cfg's `listen
# stats`) is published on, per app/edge node. No `stats auth` is configured,
# so firewall this to trusted/admin source IPs only - see README "Firewall".

# ---------------------------------------------------------------------------
# Monitoring (docker-stack.monitoring.yml, optional - see README "Deploying
# Monitoring")
# ---------------------------------------------------------------------------

# Grafana admin login. GRAFANA_ADMIN_PASSWORD is required (no default) -
# Grafana refuses to start without it.
#GRAFANA_ADMIN_USER=admin
#GRAFANA_ADMIN_PASSWORD=change-this

# Where Grafana dashboard JSON files live on the NFS server (reuses
# NFS_SERVER above, just a different exported subdirectory) - Grafana
# re-scans it every 30s, no redeploy needed to pick up new dashboards.
#NFS_GRAFANA_DASHBOARDS_PATH=/srv/syslog-ha/nfs/grafana-dashboards

# Host ports for Prometheus/Alertmanager/Grafana, per app/edge node.
#MONITORING_PROMETHEUS_PORT=9090
#MONITORING_ALERTMANAGER_PORT=9093
#MONITORING_GRAFANA_PORT=3000
#HAPROXY_APP_STATS_PORT=7001