FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends rsyslog procps && rm -rf /var/lib/apt/lists/*
COPY rsyslog/syslog.conf /etc/rsyslog.d/syslog.conf
EXPOSE 514 514/udp
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD pgrep -x rsyslogd || exit 1
CMD ["rsyslogd", "-n"]