FROM node:22-alpine AS builder
WORKDIR /app

COPY frontend/package.json frontend/package-lock.json* frontend/.npmrc ./
RUN npm ci --no-audit --no-fund

RUN chown -R node:node /app && chmod -R 755 /app
USER node

COPY frontend/ .
RUN npm run build

FROM nginx:alpine
RUN apk add --no-cache openssl busybox-extras

COPY --from=builder /app/dist /usr/share/nginx/html
# .template suffix, rendered by entrypoint.sh (envsubst on $API_UPSTREAM
# only) at container start, not by nginx's own image-provided templating -
# that would substitute the file's other, legitimate nginx $-variables too.
COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf.template
COPY frontend/docker/entrypoint.sh /entrypoint.sh
COPY frontend/docker/healthcheck.sh /healthcheck.sh
COPY frontend/docker/reload-sidecar/cgi-bin/reload.sh /srv/reload-sidecar/cgi-bin/reload.sh

RUN chown -R nginx:nginx /usr/share/nginx/html \
    && chmod +x /entrypoint.sh /healthcheck.sh /srv/reload-sidecar/cgi-bin/reload.sh

EXPOSE 80 443
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD /healthcheck.sh

ENTRYPOINT ["/entrypoint.sh"]