    "regex": "traffic.*?src=(\\d+\\.\\d+\\.\\d+\\.\\d+).*?dst=(\\d+\\.\\d+\\.\\d+\\.\\d+).*?srcport=(\\d+).*?dstport=(\\d+).*?action=(\\S+).*?policyid=(\\d+).*?sessionid=(\\d+).*?proto=(\\d+).*?service=(\\S+).*?devpriority=(\\S+).*?utmstatus=(\\S+)",
