    "match_type": "hostname",
    "match_value": "fgt*",
    "regex": "threat.*?src=(\\d+\\.\\d+\\.\\d+\\.\\d+).*?dst=(\\d+\\.\\d+\\.\\d+\\.\\d+).*?action=(\\S+).*?policyid=(\\d+).*?utmstatus=(\\S+).*?msg=\"([^\"]*)\"",
